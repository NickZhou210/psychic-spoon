  "start_url": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay"],
  "orientation": "any",
  "scope": "/",
  "id": "/",
  "background_color": "#f4f6fa",
  "theme_color": "#111b2e",
